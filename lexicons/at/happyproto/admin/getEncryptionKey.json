{
  "lexicon": 1,
  "id": "at.happyproto.admin.getEncryptionKey",
  "defs": {
    "main": {
      "type": "query",
      "description": "Where an instance's encryption key is in its rotation, and whether a rotation can start now. Staff only.",
      "parameters": {
        "type": "params",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The instance's id, a UUID."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "encryptionKey"
          ],
          "properties": {
            "encryptionKey": {
              "type": "ref",
              "ref": "at.happyproto.admin.defs#encryptionKey"
            }
          }
        }
      },
      "errors": [
        {
