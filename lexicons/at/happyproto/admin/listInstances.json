{
  "lexicon": 1,
  "id": "at.happyproto.admin.listInstances",
  "defs": {
    "main": {
      "type": "query",
      "description": "Every instance, whoever owns it, with its placement. Staff only.",
      "parameters": {
        "type": "params",
        "properties": {
          "owner": {
            "type": "string",
            "format": "did",
            "description": "Only this owner's instances."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "instances"
          ],
          "properties": {
            "instances": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#adminInstance"
              }
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired",
          "description": "This endpoint requires an authenticated caller."
        },
        {
          "name": "Forbidden",
          "description": "The caller is not HappyProto staff, or the provisioner does not treat them as staff."
        },
        {
          "name": "InvalidRequest",
          "description": "owner is not a DID, or the provisioner refused the request as malformed."
        },
        {
          "name": "NotFound",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "InvalidSlug",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "SlugTaken",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "NotEntitled",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "InstanceLimit",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "NoCapacity",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "OperationInProgress",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "Upstream",
          "description": "The provisioner is unreachable, not configured, or answered with an error it does not explain to callers."
        }
      ]
    },
    "adminInstance": {
      "type": "object",
      "description": "An instance as staff see it: the customer's view, plus its owner, placement and raw states.",
      "required": [
        "id",
        "slug",
        "url",
        "plan",
        "version",
        "state",
        "createdAt",
        "ownerDid",
        "desiredState",
        "observedState",
        "routed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "A UUID."
        },
        "slug": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "plan": {
          "type": "string",
          "description": "The plan's id."
        },
        "version": {
          "type": "string",
          "description": "The HappyView release it runs."
        },
        "versionLabel": {
          "type": "string",
          "description": "The HappyView version the release carries, e.g. 3.0.0-alpha.41, when known."
        },
        "availableVersion": {
          "type": "ref",
          "ref": "#availableVersion",
          "description": "A newer release, when one is on offer."
        },
        "state": {
          "type": "string",
          "knownValues": [
            "provisioning",
            "running",
            "stopped",
            "failed",
            "deleting"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "operation": {
          "type": "ref",
          "ref": "#operation",
          "description": "The change in progress, if any."
        },
        "ownerDid": {
          "type": "string",
          "format": "did"
        },
        "hostId": {
          "type": "string",
          "description": "The host it is placed on. Absent until it is placed."
        },
        "hostName": {
          "type": "string",
          "description": "That host's name. Absent when the hosts list does not have it."
        },
        "desiredState": {
          "type": "string",
          "description": "The provisioner's desired_state."
        },
        "observedState": {
          "type": "string",
          "description": "The provisioner's observed_state."
        },
        "routed": {
          "type": "boolean",
          "description": "Whether its public URL routes to it."
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "knownValues": [
            "create",
            "update",
            "upgrade",
            "stop",
            "start",
            "destroy"
          ]
        },
        "status": {
          "type": "string",
          "knownValues": [
            "pending",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "step": {
          "type": "string",
          "description": "The step it last reached."
        },
        "error": {
          "type": "string",
          "description": "The provisioner's error code, when it failed."
        }
      }
    },
    "availableVersion": {
      "type": "object",
      "description": "A newer HappyView release the instance can upgrade to.",
      "required": [
        "version",
        "releasedAt"
      ],
      "properties": {
        "version": {
          "type": "string",
          "description": "The release to pass to at.happyproto.server.upgradeInstance."
        },
        "label": {
          "type": "string",
          "description": "The HappyView version the release carries, e.g. 3.0.0-alpha.41, when known."
        },
        "releasedAt": {
          "type": "string",
          "format": "datetime",
          "description": "When HappyProto first offered it."
        }
      }
    }
  }
}
