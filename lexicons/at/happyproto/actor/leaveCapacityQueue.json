{
  "lexicon": 1,
  "id": "at.happyproto.actor.leaveCapacityQueue",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Take the caller out of the capacity queue, which a create that found no room put them in. Leaving when not queued succeeds. Customers only.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "idempotencyKey"
          ],
          "properties": {
            "idempotencyKey": {
              "type": "string",
              "description": "A UUID the client generates once per request and resends on every retry of it."
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "removed"
          ],
          "properties": {
            "removed": {
              "type": "boolean",
              "description": "Whether the caller was in the queue."
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired",
          "description": "This endpoint requires an authenticated caller."
        },
        {
          "name": "InvalidRequest",
          "description": "idempotencyKey is missing or malformed, or the provisioner refused the request as malformed."
        },
        {
          "name": "Forbidden",
          "description": "The caller is not a customer, or the provisioner refused them."
        },
        {
          "name": "NotFound",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "InvalidSlug",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "SlugTaken",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "NotEntitled",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "InstanceLimit",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "NoCapacity",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "OperationInProgress",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "AccountSuspended",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "PlanNotOffered",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "Upstream",
          "description": "The provisioner is unreachable, not configured, or answered with an error it does not explain to callers."
        }
      ]
    }
  }
}
