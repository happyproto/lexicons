{
  "lexicon": 1,
  "id": "at.happyproto.plugin.profile",
  "defs": {
    "main": {
      "type": "record",
      "description": "A HappyView plugin package, in its publisher's repo. The record key is the package slug, so the slug is immutable: changing it means a different package.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["type", "license", "authors", "security"],
        "properties": {
          "type": {
            "type": "string",
            "const": "happyview-plugin",
            "description": "Names the ecosystem. A client that does not understand the value refuses the package rather than guessing."
          },
          "license": {
            "type": "string",
            "maxLength": 256,
            "description": "An SPDX expression, or the literal 'proprietary'."
          },
          "authors": {
            "type": "array",
            "minLength": 1,
            "items": { "type": "ref", "ref": "#author" }
          },
          "security": {
            "type": "array",
            "minLength": 1,
            "description": "Where to report a vulnerability. At least one, because a plugin runs as native code in an operator's process.",
            "items": { "type": "ref", "ref": "#contact" }
          },
          "name": {
            "type": "string",
            "maxGraphemes": 64,
            "maxLength": 640,
            "description": "Display name. The slug is used when absent."
          },
          "description": {
            "type": "string",
            "maxGraphemes": 300,
            "maxLength": 3000,
            "description": "One line, 140 graphemes or fewer recommended."
          },
          "keywords": {
            "type": "array",
            "maxLength": 20,
            "description": "Five or fewer recommended.",
            "items": { "type": "string", "maxGraphemes": 32, "maxLength": 320 }
          },
          "sections": { "type": "ref", "ref": "#sections" },
          "lastUpdated": { "type": "string", "format": "datetime" }
        }
      }
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "maxGraphemes": 64, "maxLength": 640 },
        "url": { "type": "string", "format": "uri" },
        "email": { "type": "string", "maxLength": 320 }
      }
    },
    "contact": {
      "type": "object",
      "description": "A security contact. Either field satisfies it, but an entry with neither says nothing.",
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "email": { "type": "string", "maxLength": 320 }
      }
    },
    "sections": {
      "type": "object",
      "description": "Long-form CommonMark, rendered as untrusted input with raw HTML stripped.",
      "properties": {
        "description": { "type": "string", "maxGraphemes": 2000, "maxLength": 20000 },
        "installation": { "type": "string", "maxGraphemes": 2000, "maxLength": 20000 },
        "changelog": { "type": "string", "maxGraphemes": 2000, "maxLength": 20000 },
        "security": { "type": "string", "maxGraphemes": 2000, "maxLength": 20000 }
      }
    }
  }
}
