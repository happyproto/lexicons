{
  "lexicon": 1,
  "id": "at.happyproto.server.getInstance",
  "defs": {
    "main": {
      "type": "query",
      "description": "One of the caller's own instances. Customers only.",
      "parameters": {
        "type": "params",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The instance's UUID."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "instance"
          ],
          "properties": {
            "instance": {
              "type": "ref",
              "ref": "#instance"
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired",
          "description": "This endpoint requires an authenticated caller."
        },
        {
          "name": "Forbidden",
          "description": "The caller is not a HappyProto customer, or the provisioner refused them."
        },
        {
          "name": "InvalidRequest",
          "description": "id is not a UUID."
        },
        {
          "name": "NotFound",
          "description": "No such instance, or it is not the caller's. The two are indistinguishable."
        },
        {
          "name": "InvalidSlug",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "SlugTaken",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "NotEntitled",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "InstanceLimit",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "NoCapacity",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "OperationInProgress",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "Upstream",
          "description": "The provisioner is unreachable, not configured, or answered with an error it does not explain to callers."
        }
      ]
    },
    "instance": {
      "type": "object",
      "description": "A customer's HappyView instance. Never carries the provisioner's placement or internal fields.",
      "required": [
        "id",
        "slug",
        "url",
        "plan",
        "version",
        "state",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "A UUID."
        },
        "slug": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "plan": {
          "type": "string",
          "description": "The plan's id."
        },
        "version": {
          "type": "string",
          "description": "The HappyView release it runs."
        },
        "state": {
          "type": "string",
          "knownValues": [
            "provisioning",
            "running",
            "stopped",
            "failed",
            "deleting"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "datetime"
        },
        "operation": {
          "type": "ref",
          "ref": "#operation",
          "description": "The change in progress, if any."
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "knownValues": [
            "create",
            "update",
            "upgrade",
            "stop",
            "start",
            "destroy"
          ]
        },
        "status": {
          "type": "string",
          "knownValues": [
            "pending",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "step": {
          "type": "string",
          "description": "The step it last reached."
        },
        "error": {
          "type": "string",
          "description": "The provisioner's error code, when it failed."
        }
      }
    }
  }
}
