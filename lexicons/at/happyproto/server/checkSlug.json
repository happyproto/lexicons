{
  "lexicon": 1,
  "id": "at.happyproto.server.checkSlug",
  "defs": {
    "main": {
      "type": "query",
      "description": "Whether a slug can be used for a new instance. Customers only. An invalid or reserved slug is answered without asking the provisioner.",
      "parameters": {
        "type": "params",
        "required": [
          "slug"
        ],
        "properties": {
          "slug": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "available"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "knownValues": [
                "invalid",
                "reserved",
                "taken"
              ],
              "description": "Why not, when it is not available."
            }
          }
        }
      },
      "errors": [
        {
          "name": "AuthRequired",
          "description": "This endpoint requires an authenticated caller."
        },
        {
          "name": "Forbidden",
          "description": "The caller is not a HappyProto customer, or the provisioner refused them."
        },
        {
          "name": "InvalidRequest",
          "description": "slug is missing."
        },
        {
          "name": "NotFound",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "InvalidSlug",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "SlugTaken",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "NotEntitled",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "InstanceLimit",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "NoCapacity",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "OperationInProgress",
          "description": "Passed through from the provisioner."
        },
        {
          "name": "Upstream",
          "description": "The provisioner is unreachable, not configured, or answered with an error it does not explain to callers."
        }
      ]
    }
  }
}
