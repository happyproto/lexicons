# The HappyView release the integration stack runs. Infrastructure pins the
# same release for api.happyproto.at, so bump the two together.
#
# It has to be at least as new as the plugins below: an interpreter built
# against a host import this release does not define is refused at load with
# `unknown host function import`, and the stack then comes up with no
# interpreter at all. `host_module_resolve` landed in alpha.18.
HAPPYVIEW_VERSION=3.0.0-alpha.42

# Everything else is pinned by digest: happyproto/pds-test rebuilds its tags
# nightly, and an upstream PDS release has already broken this stack once.
# Bump deliberately, after a green run against the new image.
PLC_IMAGE=ghcr.io/happyproto/pds-test/plc@sha256:be4b9b844e460085372b74194d4d6417206f420b1f1d36c8c8ab86b5d8db9ce5
PDS_IMAGE=ghcr.io/happyproto/pds-test/tranquil@sha256:dde9fa8b6223f2b1cfea5a4e044cf2516def3ddf4f2e73c02e66e7c7c8fc6381
POSTGRES_IMAGE=postgres@sha256:2d2b8998d31037bf721cfdf764d76ba74171b4fab3431b7f72c27c56ddbdf9e3
BUN_IMAGE=oven/bun@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895
CADDY_IMAGE=caddy@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f
